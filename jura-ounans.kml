<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>Jura vanaf Ounans</name>
<description>Alle plekken uit de gids, gegroepeerd per uitje. Adres en parkeerinfo staan bij elk punt.</description>
<Style id="s_24503f"><IconStyle><color>ff3f5024</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff3f5024</color></LabelStyle></Style>
<Style id="s_2f6b52"><IconStyle><color>ff526b2f</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff526b2f</color></LabelStyle></Style>
<Style id="s_5b4a86"><IconStyle><color>ff864a5b</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff864a5b</color></LabelStyle></Style>
<Style id="s_8b8377"><IconStyle><color>ff77838b</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff77838b</color></LabelStyle></Style>
<Style id="s_9c3f5b"><IconStyle><color>ff5b3f9c</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff5b3f9c</color></LabelStyle></Style>
<Style id="s_b0700f"><IconStyle><color>ff0f70b0</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><color>ff0f70b0</color></LabelStyle></Style>
<Folder><name>Basis</name>
<Placemark><name>Camping Huttopia La Plage Blanche</name><description><![CDATA[<b>3 Rue de la Plage, 39380 Ounans</b><br><br>Jullie basis. Tel. +33 3 84 37 69 63. Val'Nature (kano) zit op nr. 1, praktisch naast de ingang.]]></description><styleUrl>#s_24503f</styleUrl><Point><coordinates>5.664300,47.002900,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Aankomstdag - Foret de Chaux</name>
<Placemark><name>Foret de Chaux - ingang Santans</name><description><![CDATA[<b>39380 Santans</b><br><br>Vijf minuten rijden. Vlak, koel, leeg. Geen kaartje, geen route. Mooiste op het laatste uur voor zonsondergang: motor uit, reeen en zwijnen zijn heel gewoon.]]></description><styleUrl>#s_b0700f</styleUrl><Point><coordinates>5.645000,46.999000,0</coordinates></Point></Placemark>
<Placemark><name>Baraques du 14</name><description><![CDATA[<b>39380 La Vieille-Loye</b><br><br>Laatste gehucht van de houtskoolbranders: vier huisjes, twee broodovens, een bijenkorf. Oudste uit de 16e eeuw. Seizoensgebonden open.]]></description><styleUrl>#s_b0700f</styleUrl><Point><coordinates>5.617000,47.049000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Uitje 1 - Bron van de Lison (must do)</name>
<Placemark><name>P Bron van de Lison</name><description><![CDATA[<b>Creux de la Doye, 25330 Nans-sous-Sainte-Anne</b><br><br>PARKEREN: gratis, ongeveer 200 m van de bron.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.007000,46.964000,0</coordinates></Point></Placemark>
<Placemark><name>Bron van de Lison</name><description><![CDATA[<b>25330 Nans-sous-Sainte-Anne</b><br><br>Rondje van 5 km, officieel zeer makkelijk, 1u30, vlak bospad. Bron -&gt; Creux Billard (doline van 100 m diep) -&gt; Grotte Sarrazine (open grotportaal van 100 m hoog, geen kaartje, geen gids). Korter kan: alleen de bron en terug is nog geen kilometer.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.005000,46.955300,0</coordinates></Point></Placemark>
<Placemark><name>Gour de Conche</name><description><![CDATA[<b>D102, 25440 Myon</b><br><br>Waterval van 17 m, door Courbet geschilderd. Vanaf de brug het GR-pad op, 150-200 m. Vaak nat en glad. PARKEREN: bij het voetbalveld in Myon, D15 richting Doulaize.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.923500,46.986500,0</coordinates></Point></Placemark>
<Placemark><name>Lunch - Salins-les-Bains</name><description><![CDATA[<b>39110 Salins-les-Bains</b><br><br>Brasserie le Thermal (simpel) of Domaine La Scierie (mooier, reserveren).]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.878000,46.943000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Uitje 2a - Cascade des Tufs (ochtend)</name>
<Placemark><name>Arbois</name><description><![CDATA[<b>Place du Champ de Mars, 39600 Arbois</b><br><br>Ligt op de route, geen omweg. Markt op vrijdagochtend. PARKEREN: gratis op Champ de Mars, Place Notre-Dame, Place Hausach, rue des Fosses, Promenade des Tiercelines. LET OP: op vrijdag staat de markt op de Champ de Mars - parkeer dan bij het zwembad, Avenue General Leclerc.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.775000,46.904000,0</coordinates></Point></Placemark>
<Placemark><name>P Cartonnerie de Mesnay</name><description><![CDATA[<b>La Cartonnerie, 39600 Mesnay</b><br><br>Hier parkeren en op de gratis pendelbus stappen (elke 15 min, 10-12u en 13.30-18u, TOT EIND AUGUSTUS). Het dorp Les Planches is in de vakantie en het weekend afgesloten voor auto's.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.783300,46.896700,0</coordinates></Point></Placemark>
<Placemark><name>Cascade des Tufs</name><description><![CDATA[<b>39600 Les Planches-pres-Arbois</b><br><br>DE waterval van de streek: gevoed door bronwater, dus stroomt ook in een droge zomer. Kwartier lopen vanaf de halte. Zwemmen mag niet. ALS DE BUS NIET RIJDT: parkeren bij Au Bourbet (80 plekken, 300 m voor het dorp aan de RD247) of Verger Maillard (25 plekken, achter de kerk).]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.805600,46.875400,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Uitje 2b - Belvedere (aparte avond)</name>
<Placemark><name>Belvedere du Fer a Cheval</name><description><![CDATA[<b>Route d'Arbois, 39600 La Chatelaine</b><br><br>Kijkt neer op de cascade. Mooier dan Baume, meestal leeg, op zijn best in het late licht. Korte wandeling. PARKEREN: bij de Auberge du Fer a Cheval, direct aan het uitzichtpunt. 30 min van de camping.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.809300,46.867800,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Uitje 3 - Baume-les-Messieurs (must do)</name>
<Placemark><name>Belvedere des Roches de Baume</name><description><![CDATA[<b>Route de Crancot, 39210 Hauteroche</b><br><br>EERST HIERHEEN, daarna pas afdalen. PARKEREN: gratis, ruim, wat hellend, alleen overdag. LET OP: een recente melding zegt dat de gemeente hem heeft afgesloten met een pendelbus - niet bevestigd, bel de VVV van Lons.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.639800,46.688000,0</coordinates></Point></Placemark>
<Placemark><name>Baume-les-Messieurs</name><description><![CDATA[<b>39210 Baume-les-Messieurs</b><br><br>Abdij met kloostergang en Vlaams retabel, vrij te bezichtigen. Cascade op 1 min van de parkeerplaats, gevoed door een ondergrondse rivier. PARKEREN: meerdere gratis plekken voor het dorp, een bij de cascade met winkeltje en terras; het kleine plekje bij de abdij zit snel vol. Eenrichtingsverkeer.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.647000,46.706000,0</coordinates></Point></Placemark>
<Placemark><name>Chateau-Chalon</name><description><![CDATA[<b>39210 Chateau-Chalon</b><br><br>Dorp van 150 inwoners op een rotsspoor, uitzicht over de Bresse-vlakte. 20 min rondlopen. PARKEREN: drie plekken bij de dorpsingang - Petit Cour, la Roche, la Tour.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>5.635000,46.755000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Uitje 4 - Chateau de Joux (must do)</name>
<Placemark><name>Chateau de Joux</name><description><![CDATA[<b>Route du Chateau, 25300 La Cluse-et-Mijoux</b><br><br>Tien eeuwen militaire architectuur, Vauban. Twee uur binnen. Er is een uitgezette route die je zelf loopt, naast de rondleiding - die geeft juist toegang tot delen die anders dicht zijn. Rotsig pad, veel trappen. Tel. 03 81 69 47 95. PARKEREN: lage en hoge parkeerplaats; de hoge scheelt klimmen.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.383000,46.856000,0</coordinates></Point></Placemark>
<Placemark><name>Lunch - Pontarlier</name><description><![CDATA[<b>25300 Pontarlier</b><br><br>10 min van het kasteel, ruime keuze.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.355000,46.904000,0</coordinates></Point></Placemark>
<Placemark><name>Bron van de Loue</name><description><![CDATA[<b>25520 Ouhans</b><br><br>De rivier die langs de camping stroomt komt hier uit een rotswand van 100 m. Paar minuten over verhard pad. PARKEREN: betaald, muntgeld mee.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.322000,46.999000,0</coordinates></Point></Placemark>
<Placemark><name>Mouthier-Haute-Pierre</name><description><![CDATA[<b>25920 Mouthier-Haute-Pierre</b><br><br>De mooie weg terug.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.281000,47.048000,0</coordinates></Point></Placemark>
<Placemark><name>Lods</name><description><![CDATA[<b>25930 Lods</b><br><br>Een van de mooiste dorpen van Frankrijk. Terrasjes aan het water - goede lunchplek.]]></description><styleUrl>#s_2f6b52</styleUrl><Point><coordinates>6.235000,47.056000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Zaterdag - Dole</name>
<Placemark><name>Brocante Damparis</name><description><![CDATA[<b>Ferme de la Borde, 39500 Damparis</b><br><br>Vide-grenier met ambacht. Vroeg gaan, voor tienen is het goede spul weg. PARKEREN: gratis eigen terrein op het domein.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.437000,47.088000,0</coordinates></Point></Placemark>
<Placemark><name>Markt Dole</name><description><![CDATA[<b>Halles de Dole + Place Nationale, 39100 Dole</b><br><br>DE markt van de week: overdekte Halles 8-13.30u en buitenmarkt op de Place Nationale 8-13u, naast elkaar in de oude stad.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.490000,47.093000,0</coordinates></Point></Placemark>
<Placemark><name>P Place Jules Grevy</name><description><![CDATA[<b>Place Jules Grevy, 39100 Dole</b><br><br>PARKEREN: grote gratis gemeenteparkeerplaats, dichtst bij de Collegiale en de markt. Vol? Gratis aan de Cours Georges Clemenceau (theater) of betaald bij de Terreaux, Rue de Besancon. De markt staat op de Place Nationale - dat is dus geen parkeeroptie.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.491500,47.094000,0</coordinates></Point></Placemark>
<Placemark><name>Canal des Tanneurs</name><description><![CDATA[<b>Rue Pasteur, 39100 Dole</b><br><br>De leerlooiershuizen stappen zo het water in - de mooiste 200 meter stadsbeeld van het departement.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.491500,47.092500,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Zondag - Route A (dichtbij)</name>
<Placemark><name>Puces de Choisey</name><description><![CDATA[<b>Stade de football, 39100 Choisey</b><br><br>Vroeg gaan, contant geld mee. PARKEREN: bij het sportterrein; niet vooraf geverifieerd, meestal met borden ter plekke.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.478000,47.055000,0</coordinates></Point></Placemark>
<Placemark><name>Vide-grenier Sampans</name><description><![CDATA[<b>Terrain de petanque, 39100 Sampans</b><br><br>10 min van Choisey. PARKEREN: in de straten rond het terrein; niet vooraf geverifieerd.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.478000,47.145000,0</coordinates></Point></Placemark>
<Placemark><name>Dole - lunch</name><description><![CDATA[<b>39100 Dole</b><br><br>Zondag de enige plek in de buurt waar genoeg open is. Reserveren. Parkeren op Place Jules Grevy, gratis en rustig op zondag.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.490000,47.093000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Zondag - Route B (met kasteel)</name>
<Placemark><name>Vide-grenier Quintigny</name><description><![CDATA[<b>Rue Charles Nodier, 39570 Quintigny</b><br><br>Loopt door de straten van het dorp. Ligt op 2,8 km van Chateau d'Arlay - de leukste combinatie van het weekend. PARKEREN: aan de rand, volg de borden; niet vooraf geverifieerd.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.524000,46.734000,0</coordinates></Point></Placemark>
<Placemark><name>Chateau d'Arlay</name><description><![CDATA[<b>2 Route de Proby, 39140 Arlay</b><br><br>Burchtruine, 18e-eeuws kasteel en 8 ha park. Volledig zelfstandig, 1u30, geen groep, geen tijdslot, terras voor koffie. Tel. 03 84 85 04 22. PARKEREN: bij de ingang, tien meter rechts nadat je de route de Proby inslaat.]]></description><styleUrl>#s_9c3f5b</styleUrl><Point><coordinates>5.512000,46.746000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Verborgen parels</name>
<Placemark><name>Markt Salins-les-Bains</name><description><![CDATA[<b>Place des Salines, 39110 Salins-les-Bains</b><br><br>Donderdag- en zaterdagochtend.]]></description><styleUrl>#s_b0700f</styleUrl><Point><coordinates>5.878000,46.943000,0</coordinates></Point></Placemark>
<Placemark><name>Fort Saint-Andre</name><description><![CDATA[<b>39110 Salins-les-Bains</b><br><br>Vauban-fort uit 1674, zelfstandig rond te lopen over de wallen en door de kazematten. ALLEEN MA-VR 14-18u, seizoen stopt meestal eind augustus - bel de VVV. 3 euro, contant. PARKEREN: je rijdt tot aan het fort, parkeerplaats bij de poort.]]></description><styleUrl>#s_b0700f</styleUrl><Point><coordinates>5.862000,46.937000,0</coordinates></Point></Placemark>
<Placemark><name>Port-Lesney - zwemmen</name><description><![CDATA[<b>Bij de brug, 39330 Port-Lesney</b><br><br>Kiezelbanken bij de brug, diepere kommen eronder. Na zevenen 's avonds is iedereen weg. Klimmetje van 20 min naar de Chapelle Saint-Eloi voor het uitzicht.]]></description><styleUrl>#s_b0700f</styleUrl><Point><coordinates>5.822000,46.981000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Dorpen &amp; stadjes</name>
<Placemark><name>Chissey-sur-Loue - Eglise Saint-Christophe</name><description><![CDATA[<b>Rue de l'Eglise, 39380 Chissey-sur-Loue</b><br><br>Acht minuten van de camping. Kerk uit de 12e-13e eeuw met 64 gebeeldhouwde pelgrimskoppen langs de kroonlijst - grimassend, lachend, angstaanjagend. De dorpelingen heten daarom de Babouins. Gratis, zomer 9-20u.]]></description><styleUrl>#s_5b4a86</styleUrl><Point><coordinates>5.735000,46.983000,0</coordinates></Point></Placemark>
<Placemark><name>Poligny</name><description><![CDATA[<b>39800 Poligny</b><br><br>Comte-hoofdstad vol kaaswinkels en fruitieres. 15e-eeuwse collegiale Saint-Hippolyte, ruine van Chateau de Grimont erboven, oude wijnbouwerswijk Charcigny. Hotelvakschool met twee opleidingsrestaurants open voor publiek (le Geneve, le Relais Polinois) - goede prijs-kwaliteit, reserveren. Markt ma + vr ochtend.]]></description><styleUrl>#s_5b4a86</styleUrl><Point><coordinates>5.706000,46.837000,0</coordinates></Point></Placemark>
<Placemark><name>Pesmes</name><description><![CDATA[<b>70140 Pesmes</b><br><br>Het enige Plus Beau Village de France van de Haute-Saone. Middeleeuwse vestingmuren hoog boven de Ognon, smalle wijnbouwerssteegjes, resten van het kasteel, kerk met comtoise klokkentoren met geglazuurde pannen. Oude smederij is nu museum.]]></description><styleUrl>#s_5b4a86</styleUrl><Point><coordinates>5.563000,47.277000,0</coordinates></Point></Placemark>
<Placemark><name>Lons-le-Saunier</name><description><![CDATA[<b>Rue du Commerce, 39000 Lons-le-Saunier</b><br><br>Hoofdstad van de Jura. De Rue du Commerce is een lange 18e-eeuwse arcade vol terrassen; Rouget de Lisle werd er in 1760 geboren en schreef de Marseillaise. Parc des Bains met zoute thermen. Markt donderdagochtend op de Place de Verdun - de stad noemt hem de grootste van het departement.]]></description><styleUrl>#s_5b4a86</styleUrl><Point><coordinates>5.554000,46.674000,0</coordinates></Point></Placemark>
<Placemark><name>Nozeroy</name><description><![CDATA[<b>39250 Nozeroy</b><br><br>Piepklein middeleeuws stadje op een heuvelrug, de Cite des Chalon: stadspoort, kasteelrestanten, uitzicht over het plateau. Half uur rondlopen. Ligt op de route naar Joux.]]></description><styleUrl>#s_5b4a86</styleUrl><Point><coordinates>6.078000,46.775000,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Leuk als je in de buurt bent</name>
<Placemark><name>Saline Royale</name><description><![CDATA[<b>Grande Rue, 25610 Arc-et-Senans</b><br><br>18e-eeuwse zoutziederij, opgezet als halfronde ideale stad en nooit afgemaakt. Zelfstandig, 2 uur genoeg. 9-19u, 15 euro. Ligt op de route naar huis.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>5.777000,47.032000,0</coordinates></Point></Placemark>
<Placemark><name>Citadelle de Besancon</name><description><![CDATA[<b>99 Rue des Fusilles de la Resistance, 25000 Besancon</b><br><br>Vauban, UNESCO, in een haarspeldbocht van de Doubs. De vestingmuren lopen is al genoeg. 9-19u, ca. 13,50 euro.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>6.035000,47.231000,0</coordinates></Point></Placemark>
<Placemark><name>Ornans</name><description><![CDATA[<b>25290 Ornans</b><br><br>Kleine Venetie van Franche-Comte: huizen op palen boven het water. Lunch: La Terrasse sur Loue.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>6.144000,47.104000,0</coordinates></Point></Placemark>
<Placemark><name>Chateau de Cleron</name><description><![CDATA[<b>25330 Cleron</b><br><br>Kasteel uit 1320 midden in de rivier. Particulier - van buiten, vanaf de brug. Je hoeft niet uit te stappen.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>6.079000,47.076000,0</coordinates></Point></Placemark>
<Placemark><name>Chateau du Pin</name><description><![CDATA[<b>361 Chemin du Chateau, 39210 Le Pin</b><br><br>13e-eeuwse burcht met donjon, ronde torens en weergang. Blijde in de tuin. ALLEEN ALLEEN JULI EN AUGUSTUS, 13-19u, 8 euro. Tel. 03 84 25 32 95.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>5.652000,46.615000,0</coordinates></Point></Placemark>
<Placemark><name>Lac de Chalain - Doucier</name><description><![CDATA[<b>39130 Doucier</b><br><br>Turquoise, bewaakte stranden, warmer dan de rivier. Druk in augustus.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>5.812000,46.669000,0</coordinates></Point></Placemark>
<Placemark><name>Zwemmen Chamblay</name><description><![CDATA[<b>39380 Chamblay</b><br><br>Rustiger rivieraccess dan de camping. Bronwater, dus koud.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>5.717000,46.976000,0</coordinates></Point></Placemark>
<Placemark><name>Chateau d'Oricourt</name><description><![CDATA[<b>70110 Oricourt</b><br><br>Best bewaarde middeleeuwse burcht van Franche-Comte: twee torens van 25 m, dubbele ringmuur, diepe grachten. Alleen met gids. 1u40 rijden - de andere kandidaat naast Joux.]]></description><styleUrl>#s_8b8377</styleUrl><Point><coordinates>6.360000,47.600000,0</coordinates></Point></Placemark>
</Folder>
</Document></kml>